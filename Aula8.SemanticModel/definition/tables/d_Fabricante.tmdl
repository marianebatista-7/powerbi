	column 'Fabricantes (grupos)' =
			SWITCH(
				TRUE,
				ISBLANK('d_Fabricante'[Fabricantes]),
				"(Em branco)",
				'd_Fabricante'[Fabricantes] IN {"VanArsdel"},
				"Principal",
				'd_Fabricante'[Fabricantes] IN {"Aliqui",
					"Currus",
					"Pirum"},
				"Secundários",
				"Outros"
			)
		lineageTag: ff38712e-71d6-4c2d-b6af-51218339a513
		summarizeBy: none

